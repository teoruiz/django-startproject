# Host ports; values below derive from them. PostgreSQL is published on 127.0.0.1 only.
POSTGRES_PORT=5432
DJANGO_PORT=8000
FRONTEND_PORT=5173
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:${FRONTEND_PORT},http://127.0.0.1:${FRONTEND_PORT}
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:${POSTGRES_PORT}/app
# SECRET_KEY is required unless DJANGO_DEBUG=true; development falls back to the generated key.

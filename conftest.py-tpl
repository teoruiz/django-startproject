import pytest


@pytest.fixture(autouse=True)
def test_settings(settings, tmp_path):
    settings.MAILERS = {"default": {"BACKEND": "django.core.mail.backends.locmem.EmailBackend"}}
    settings.STATIC_ROOT = tmp_path / "static"
    # Tests never depend on a real frontend build; frontend tests write a fake one here.
    settings.FRONTEND_DIR = settings.WHITENOISE_ROOT = tmp_path / "frontend"
    settings.STATIC_ROOT.mkdir()
    settings.FRONTEND_DIR.mkdir()
    settings.PASSWORD_HASHERS = ["django.contrib.auth.hashers.MD5PasswordHasher"]
    settings.SESSION_COOKIE_SECURE = False
    settings.CSRF_COOKIE_SECURE = False
    settings.ACCOUNT_RATE_LIMITS = {}
    settings.STORAGES = {
        "default": {"BACKEND": "django.core.files.storage.FileSystemStorage"},
        "staticfiles": {"BACKEND": "django.contrib.staticfiles.storage.StaticFilesStorage"},
    }
    settings.TASKS = {"default": {"BACKEND": "django.tasks.backends.immediate.ImmediateBackend"}}
